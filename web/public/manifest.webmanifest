{
  "id": "/",
  "name": "postbuch.net",
  "short_name": "postbuch.net",
  "description": "Dokumentenverwaltung & postbuch.net",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "capture_links": "existing-client-navigate",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "background_color": "#7c3aed",
  "theme_color": "#7c3aed",
  "share_target": {
    "action": "/geteilt",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "pdf",
          "accept": ["application/pdf", ".pdf"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/Postbuch-Logo192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/Postbuch-Logo512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/postbuch-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
