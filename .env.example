# ╔═══════════════════════════════════════════════════════════════════╗
# ║                    POSTBUCH UNIFIED CONFIG                       ║
# ║                                                                  ║
# ║  Nur statische Secrets hier. Dynamische Konfiguration            ║
# ║  (OneDrive-Ordner, Tokens, Features) wird in der GUI verwaltet. ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=postbuch
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=postbuch

# ── App: Authentifizierung ─────────────────────────────────────────
SESSION_SECRET=CHANGEME_32_BYTE_HEX
APP_PASSWORD=CHANGEME
APP_ADMIN_USERNAME=admin
INSTANCE_NAME=Postbuch

# ── LLM: Dokumentenanalyse ────────────────────────────────────────
# Optional. Beide leer lassen, wenn die Instanz cloudfrei laufen soll —
# lokale Provider (Ollama, LM Studio, OpenRouter, beliebige OpenAI-kompatible
# Dienste) werden ausschließlich im Web-UI unter Einstellungen → KI angelegt,
# nicht hier. Ohne jeden Provider bleibt nur die Dokumentenanalyse aus.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Ablage ─────────────────────────────────────────────────────────
# 'onedrive' oder 'nextcloud'. Wirkt AUSSCHLIESSLICH bei der Erstinstallation
# gegen eine leere Datenbank (keine Dokumente, keine Ordnerstruktur).
# Auf einer benutzten Instanz wird die aktive Ablage nur über die Weboberfläche
# umgeschaltet — Einstellungen → Ablage, am Ende eines Umzugs. Ein Ändern
# dieser Zeile bleibt dort wirkungslos.
STORAGE_BACKEND=onedrive
APP_BASE_URL=http://localhost:3420

# ── Zugang zur Bezugsquelle ────────────────────────────────────────
# Die Bezugsquelle ist eine Eigenschaft dieser Instanz. Sie liefert
# Release-Manifest und Tarballs; Modellempfehlungen stecken lokal im
# installierten Release. Standard sind die öffentlichen GitHub Releases des
# Projekts. Soll eine Instanz gar keine Updates abrufen, bleibt die Zeile leer;
# der Installer setzt dann nichts still ein, sondern verlangt --quelle=<url>.
# HTTPS-URL ohne Zugangsdaten, Query oder Fragment.
POSTBUCH_FEED_BASE_URL=https://github.com/ceramgcf/postbuch.net/releases

# HTTP-Basic-Zugang zur Bezugsquelle, falls sie geschützt ist.
# Form: benutzer:passwort — die Angaben kommen vom Betreiber. Bei einer
# öffentlichen Bezugsquelle bleibt diese Zeile leer.
POSTBUCH_FEED_AUTH=

# ── Variante A: OneDrive / Azure ───────────────────────────────────
# Nur nötig für STORAGE_BACKEND=onedrive.
# OAuth-Tokens werden über die GUI erworben und in der DB gespeichert.
# Die Callback-URL für die Kontoverknüpfung wird aus APP_BASE_URL gebildet.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=consumers

# ── Variante B: eigene Nextcloud ───────────────────────────────────
# Hier ist bewusst NICHTS einzutragen — weder Server-Adresse noch Zugangsdaten.
# Beides gehört ins Web-UI (Einstellungen → Ablage): dort wird geprüft, ob die
# Adresse zulässig ist (unverschlüsseltes http nur für Server im eigenen Netz
# und nur mit ausdrücklicher Bestätigung), und die Anmeldung erzeugt über den
# Nextcloud-Login ein eigenes App-Passwort. Dein Nextcloud-Hauptpasswort
# bekommt Postbuch nie zu sehen.

# ── Benachrichtigungen ────────────────────────────────────────────
# PWA-/Browser-Push wird im Web-UI unter Einstellungen → Benachrichtigungen
# eingerichtet und ist der empfohlene Weg. Discord ist experimentell und wird
# wegen möglicher Datenoffenlegung bei Fehlkonfiguration nicht empfohlen. Neue
# Discord-Zugangsdaten deshalb nur nach dem Warnhinweis im Web-UI hinterlegen.

# ── Scanner (Hardware-Konfiguration) ──────────────────────────────
# SCANNER_DEVICE_URL=http://192.168.1.100:80/eSCL
# SCANNER_PORT=8080
# OCR_ENABLED=1
# OCR_LANGS=deu

# ── Ports ──────────────────────────────────────────────────────────
WEB_PORT=3420
POSTGRES_HOST_PORT=5433  # Host port mapped to Postgres container (default 5433)

# ── Caddy (Reverse Proxy mit HTTPS — Standard) ─────────────────────
# Variante A: kostenlose DuckDNS-Subdomain (https://www.duckdns.org)
# DUCKDNS_API_TOKEN=
# DUCKDNS_DOMAIN=deinname.duckdns.org
# Variante B: eigene Domain, DNS bei Cloudflare.
# API-Token für DNS-01-TLS-Challenge, benötigt Zone:Read + DNS:Edit.
CF_API_TOKEN=

# ── Seeding-Override ───────────────────────────────────────────────
# Auf 1 setzen, um DB-Werte mit ENV-Werten zu überschreiben
ENV_FORCE_OVERRIDE=0
